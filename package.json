{
  "name": "@libraz/formulon-mcp",
  "version": "0.9.1",
  "description": "MCP server for Formulon Excel-compatible formula and workbook evaluation",
  "license": "Apache-2.0",
  "author": "libraz",
  "homepage": "https://github.com/libraz/formulon-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libraz/formulon-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/libraz/formulon-mcp/issues"
  },
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "bin": "dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "biome check . && tsc -p tsconfig.json --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "yarn run build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "yarn run build && vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node ./dist/index.js",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@libraz/formulon": "^0.16.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-js": "^2.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "anthropic",
    "ai-agents",
    "llm-tools",
    "formulon",
    "excel",
    "excel-formulas",
    "xlsx",
    "spreadsheet",
    "formula",
    "office-365",
    "typescript",
    "nodejs"
  ],
  "sideEffects": false
}
