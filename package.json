{
  "name": "@libraz/formulon-mcp",
  "version": "0.6.0",
  "description": "MCP server for Formulon Excel-compatible formula and workbook evaluation",
  "license": "Apache-2.0",
  "author": "libraz",
  "homepage": "https://github.com/libraz/formulon-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libraz/formulon-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/libraz/formulon-mcp/issues"
  },
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "bin": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "biome check . && tsc -p tsconfig.json --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "yarn run build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "yarn run build && vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node ./dist/index.js",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@libraz/formulon": "^0.11.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "anthropic",
    "ai-agents",
    "llm-tools",
    "formulon",
    "excel",
    "excel-formulas",
    "xlsx",
    "spreadsheet",
    "formula",
    "office-365",
    "typescript",
    "nodejs"
  ],
  "sideEffects": false
}
